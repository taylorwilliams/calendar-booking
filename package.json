{
  "name": "personal-booking-calendar",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "setup": "node scripts/configure-booking.mjs",
    "config:push": "node scripts/push-booking-config.mjs",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:security": "node --experimental-strip-types --test tests/security/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:cloudflare": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "check": "npm run verify:public && npm run test:security && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.2",
    "ical.js": "^2.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "json-rpc-2.0": "1.8.1",
    "raw-body": "4.0.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "fast-uri": "3.1.8",
    "fflate": "0.7.5",
    "source-map-js": "1.2.2",
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
